---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Feb 2024 - Abr 2026",
    title: "Desarrollador Full-Stack - Talana",
    description:
      "Desarrollo y refactorización de módulos de software, optimización de consultas SQL, integración de APIs REST. Implementé mejoras significativas en Calculator v3, mejorando el rendimiento y la mantenibilidad del código.",
    link: "https://www.linkedin.com/company/talana",
    tags: ["Python", "Django", "Vue.js", "FastAPI", "SQL"],
  },
];
---

<div class="space-y-6">
  {
    EXPERIENCE.map((experience) => (
      <ExperienceItem {...experience} />
    ))
  }
</div>