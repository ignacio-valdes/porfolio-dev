---
import ExperienceItem from "./ExperienceItem.astro";

const EXPERIENCE = [
  {
    date: "Enero 2026 – Abril 2026 • Híbrido",
    title: "Full Stack Developer Trainee / Part-time",
    bullets: [
      "Diseño y desarrollo de nuevas funcionalidades tanto en el Backend (Python, Django) como en el Frontend (Vue.js), asegurando una experiencia de usuario fluida y un sistema escalable.",
      "Integración y consumo de APIs REST corporativas, optimizando la comunicación entre servicios y la disponibilidad de los datos.",
      "Refactorización de código heredado (legacy code) bajo patrones de Arquitectura Limpia (Clean Architecture), mejorando drásticamente la mantenibilidad, legibilidad y el rendimiento de la plataforma.",
      "Optimización de bases de datos relacionales mediante la depuración de consultas SQL complejas, reduciendo tiempos de respuesta en módulos críticos de negocio.",
      "Colaboración activa en equipos multidisciplinarios bajo metodologías ágiles (Scrum), participando en el ciclo completo de desarrollo, desde el levantamiento de requerimientos hasta el despliegue.",
    ],
    link: "https://www.linkedin.com/company/talana",
    tags: ["Python", "Django", "Vue.js", "SQL", "APIs REST"],
  },
];
---

<div class="space-y-6">
  {
    EXPERIENCE.map((experience) => (
      <ExperienceItem {...experience} />
    ))
  }
</div>