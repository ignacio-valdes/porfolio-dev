---
interface Props {
  date: string;
  title: string;
  bullets: string[];
  link?: string;
  tags: string[];
}

const { date, title, bullets = [], link, tags = [] } = Astro.props;

const TAG_STYLES: Record<string, string> = {
  Python: "bg-amber-600/30 text-amber-100 border-amber-500/40",
  Django: "bg-emerald-700/30 text-emerald-100 border-emerald-600/40",
  "Vue.js": "bg-teal-600/30 text-teal-100 border-teal-500/40",
  FastAPI: "bg-cyan-700/30 text-cyan-100 border-cyan-600/40",
  SQL: "bg-blue-700/30 text-blue-100 border-blue-600/40",
  "APIs REST": "bg-purple-700/30 text-purple-100 border-purple-600/40",
  default: "bg-white/10 text-white border-white/20",
};

const getTagStyle = (tag: string) => TAG_STYLES[tag] || TAG_STYLES.default;
---

<div class="relative p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm">
  <div class="flex items-center gap-3 mb-2">
    <div class="w-3 h-3 bg-purple-400 rounded-full flex-shrink-0"></div>
    <time class="text-base font-medium text-gray-300">{date}</time>
  </div>
  <div class="pl-6">
    <h3 class="text-xl font-semibold text-white mb-1">{title}</h3>
    <a 
      href={link}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-flex items-center gap-1 text-purple-400 hover:text-purple-300 transition-colors mb-4"
    >
      Talana
      <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
      </svg>
    </a>
    <ul class="space-y-3 mb-4">
      {bullets.map((bullet) => (
        <li class="flex items-start gap-3">
          <span class="w-2 h-2 bg-purple-500 rounded-full mt-2 flex-shrink-0"></span>
          <span class="text-gray-300 text-sm leading-relaxed">{bullet}</span>
        </li>
      ))}
    </ul>
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class={`text-xs px-2.5 py-1 rounded-full border ${getTagStyle(tag)}`}>
          {tag}
        </span>
      ))}
    </div>
  </div>
</div>