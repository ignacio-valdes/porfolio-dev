---
interface Props {
  date: string;
  title: string;
  description: string;
  link?: string;
  tags?: string[];
}

const { date, title, description, link, tags = [] } = Astro.props;

const TAG_STYLES: Record<string, string> = {
  Python: "bg-amber-600/30 text-amber-100 border-amber-500/40",
  Django: "bg-emerald-700/30 text-emerald-100 border-emerald-600/40",
  "Vue.js": "bg-teal-600/30 text-teal-100 border-teal-500/40",
  FastAPI: "bg-cyan-700/30 text-cyan-100 border-cyan-600/40",
  SQL: "bg-blue-700/30 text-blue-100 border-blue-600/40",
  default: "bg-white/10 text-white border-white/20",
};

const getTagStyle = (tag: string) => TAG_STYLES[tag] || TAG_STYLES.default;
---

<div class="relative p-6 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-sm">
  <div class="flex items-center gap-3 mb-4">
    <div class="w-3 h-3 bg-purple-400 rounded-full"></div>
    <time class="text-sm text-gray-400">{date}</time>
  </div>
  <h3 class="text-xl font-semibold text-white mb-4">{title}</h3>
  <div class="flex flex-wrap gap-2 mb-4">
    {tags.map((tag) => (
      <span class={`text-xs px-2.5 py-1 rounded-full border ${getTagStyle(tag)}`}>
        {tag}
      </span>
    ))}
  </div>
  <p class="text-base text-gray-300 leading-relaxed mb-4">{description}</p>
  {
    link && (
      <a
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-sm font-medium text-white hover:bg-white/20 transition-all"
      >
        <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
        </svg>
        Ver en LinkedIn
      </a>
    )
  }
</div>